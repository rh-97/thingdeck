# Copy to .env to customise local Docker settings.

# Address the containers listen on. 127.0.0.1 = this machine only; 0.0.0.0 = every device on your network.
THINGSDECK_BIND=127.0.0.1

# Host ports for the dev server (make dev) and the nginx image (make prod).
THINGSDECK_PORT=5180
THINGSDECK_PROD_PORT=8080
