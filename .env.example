# Copy to .env to customise local Docker settings.

# Address the containers listen on. 127.0.0.1 = this machine only; 0.0.0.0 = every device on your network.
THINGSDECK_BIND=127.0.0.1

# Host ports for the dev server (make dev) and the nginx image (make prod).
THINGSDECK_PORT=5180
THINGSDECK_PROD_PORT=8080

# Registration: 'open' lets anyone who can reach the site sign up; 'closed' stops new accounts.
THINGSDECK_SIGNUP=open

# Optional 32-byte key (base64 or hex) for encrypting stored SmartThings tokens.
# Leave empty to generate one in the data volume on first start.
# THINGSDECK_SECRET=

# Optional outbound proxy. Leave unset if your network has direct internet access.
# Company CA certificates go in the certs/ folder instead (see certs/README.md).
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
